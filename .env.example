# Optional for FCA-only use; required to include Companies House.
COMPANIES_HOUSE_API_KEY=replace-with-your-key
# Optional for search; required for EDINET filing history and downloads.
EDINET_API_KEY=replace-with-your-key
# Required for all DART operations: company search, filing history, and
# financial statements (no keyless surface at all).
DART_API_KEY=replace-with-your-key
OPENFILINGS_DATA_DIR=.openfilings
OPENFILINGS_OCR_MODE=auto
OPENFILINGS_OCR_LANGUAGE=eng
OPENFILINGS_OCR_DPI=200
OPENFILINGS_OCR_MAX_PAGES=250
OPENFILINGS_CACHE_MAX_MB=512
# OPENFILINGS_TESSERACT_EXECUTABLE=tesseract
